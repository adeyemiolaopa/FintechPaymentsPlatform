{
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.AspNetCore":  "Warning"
                                                      }
                                     }
                },
    "LedgerDatabase":  {
                           "ConnectionString":  "Host=127.0.0.1;Port=15432;Database=payments_ledger;Username=payments;Password=change-me-local-only"
                       },
    "Redis":  {
                  "ConnectionString":  "localhost:6379"
              },
    "Kafka":  {
                  "BootstrapServers":  "localhost:9092",
                  "ProducerName":  "ledger-service",
                  "SchemaRegistryUrl":  "http://localhost:8081"
              },
    "Jwt":  {
                "Issuer":  "FintechPaymentsPlatform",
                "Audience":  "FintechPaymentsPlatform.Api",
                "SigningKey":  ""
            },
    "LedgerConsumer":  {
                           "Enabled":  true,
                           "GroupId":  "ledger-service-v1",
                           "AccountLifecycleTopic":  "account.lifecycle.v1",
                           "ConsumerName":  "ledger.account-lifecycle-v1",
                           "RetryTopics":  [
                                               "account.lifecycle.v1.retry.1m"
                                           ],
                           "DeadLetterTopic":  "ledger.account.lifecycle.v1.dlq",
                           "ImmediateRetryCount":  3,
                           "ProcessingTimeoutSeconds":  300
                       },
    "Outbox":  {
                   "PublisherEnabled":  true,
                   "BatchSize":  20,
                   "PollSeconds":  5
               },
    "Observability":  {
                          "ServiceName":  "ledger-api",
                          "EnableOtlpExporter":  false,
                          "OtlpEndpoint":  "http://localhost:4317"
                      }
}