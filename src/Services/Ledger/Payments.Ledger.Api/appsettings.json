{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "LedgerDatabase": {
    "ConnectionString": "Host=127.0.0.1;Port=15432;Database=payments_ledger;Username=payments;Password=change-me-local-only"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ProducerName": "ledger-service",
    "SchemaRegistryUrl": "http://localhost:8081"
  },
  "Jwt": {
    "Issuer": "FintechPaymentsPlatform",
    "Audience": "FintechPaymentsPlatform.Api",
    "SigningKey": ""
  },
  "LedgerConsumer": {
    "Enabled": true,
    "GroupId": "ledger-service",
    "AccountLifecycleTopic": "account.lifecycle.v1"
  },
  "Outbox": {
    "PublisherEnabled": true,
    "BatchSize": 20,
    "PollSeconds": 5
  },
  "Observability": {
    "ServiceName": "ledger-api",
    "EnableOtlpExporter": false,
    "OtlpEndpoint": "http://localhost:4317"
  }
}