{
  "IdentityDatabase": {
    "ConnectionString": "Host=127.0.0.1;Port=15432;Database=payments_identity;Username=payments;Password=change-me-local-only"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "dev:identity"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ProducerName": "identity-service",
    "SchemaRegistryUrl": "http://localhost:8081"
  },
  "Jwt": {
    "Issuer": "FintechPaymentsPlatform",
    "Audience": "FintechPaymentsPlatform.Api",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "PasswordHashing": {
    "Iterations": 210000
  },
  "Outbox": {
    "PublisherEnabled": true,
    "BatchSize": 20,
    "PollSeconds": 2
  },
  "Observability": {
    "ServiceName": "identity-api",
    "ServiceVersion": "0.2.0",
    "EnableOtlpExporter": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

