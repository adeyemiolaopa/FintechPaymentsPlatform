{
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.Hosting.Lifetime":  "Information"
                                                      }
                                     }
                },
    "Jwt":  {
                "Issuer":  "FintechPaymentsPlatform",
                "Audience":  "FintechPaymentsPlatform.Api",
                "SigningKey":  "",
                "AccessTokenMinutes":  10,
                "RefreshTokenDays":  30
            },
    "AccountDatabase":  {
                            "ConnectionString":  "Host=127.0.0.1;Port=15432;Database=payments_account;Username=payments;Password=change-me-local-only"
                        },
    "Redis":  {
                  "ConnectionString":  "localhost:6379"
              },
    "Kafka":  {
                  "BootstrapServers":  "localhost:9092",
                  "ProducerName":  "account-service",
                  "SchemaRegistryUrl":  "http://localhost:8081"
              },
    "AccountConsumer":  {
                            "Enabled":  true,
                            "GroupId":  "account-service-v1",
                            "CustomerLifecycleTopic":  "customer.lifecycle.v1",
                            "ConsumerName":  "account.customer-lifecycle-v1",
                            "RetryTopics":  [
                                                "customer.lifecycle.v1.retry.1m"
                                            ],
                            "DeadLetterTopic":  "account.customer.lifecycle.v1.dlq",
                            "ImmediateRetryCount":  3,
                            "ProcessingTimeoutSeconds":  300
                        },
    "Outbox":  {
                   "PublisherEnabled":  true,
                   "BatchSize":  20,
                   "PollSeconds":  5
               },
    "Observability":  {
                          "ServiceName":  "account-api",
                          "EnableOtlpExporter":  false
                      },
    "AllowedHosts":  "*"
}