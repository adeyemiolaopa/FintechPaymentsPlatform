# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS restore
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props ./
COPY FintechPaymentsPlatform.sln ./
COPY src ./src
RUN dotnet restore src/Simulators/Payments.RailSimulator.Api/Payments.RailSimulator.Api.csproj

FROM restore AS build
RUN dotnet publish src/Simulators/Payments.RailSimulator.Api/Payments.RailSimulator.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
LABEL org.opencontainers.image.title="payments-rail-simulator-api" \
      org.opencontainers.image.description="External payment rail simulator for FintechPaymentsPlatform"
WORKDIR /app
RUN apk add --no-cache curl krb5-libs && addgroup -S payments && adduser -S -G payments payments
COPY --from=build /app/publish ./
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
USER payments
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -f http://localhost:8080/health/live || exit 1
ENTRYPOINT ["dotnet", "Payments.RailSimulator.Api.dll"]
